# ==============================================================================
# EduNex AI — Global Environment Configuration Template (.env.example)
# Copy to .env and supply actual values before deployment
# NEVER commit .env with real credentials to version control
# ==============================================================================

# Core Application Environment ('development' | 'staging' | 'production')
ENVIRONMENT=development
DEBUG=true

# Security Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=edunex_db
POSTGRES_PORT=5432

# Backend Connection Strings (Interpolated in Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/edunex_db
SYNC_DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/edunex_db

# Frontend URLs & CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://edunex-ai.vercel.app"]

# Frontend Build Target (Public Backend API URL)
# For local Docker Compose, leave empty to use Nginx relative proxy
# For Vercel cloud deployment, set to your Railway backend URL: https://<railway-domain>.up.railway.app
VITE_API_URL=

# AI & LLM Providers (Server-side secrets)
GOOGLE_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional Local Ollama Provider (for offline execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Persistent Storage Paths (Inside Container)
CHROMA_PERSIST_DIR=/app/data/chroma

# ChromaDB server (HTTP client). CHROMA_MODE: auto | http | persistent
#   auto       = HTTP on Railway, embedded PersistentClient (CHROMA_PERSIST_DIR) elsewhere
#   http       = always use CHROMA_HOST:CHROMA_PORT
#   persistent = always use the embedded client
# Railway private network default shown; for Docker Compose use CHROMA_HOST=chromadb
CHROMA_MODE=auto
CHROMA_HOST=chromadb.railway.internal
CHROMA_PORT=8000
UPLOAD_DIR=/app/data/uploads

# Port Bindings (Host Machine)
BACKEND_PORT=8000
FRONTEND_PORT=3000

