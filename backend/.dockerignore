# Python cache and byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
tests/
test_runner.db
*.db
*.sqlite

# IDEs and local tooling
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Large model caches and data uploads (stored via Docker volumes)
data/uploads/*
!data/uploads/.gitkeep
data/chroma/*
!data/chroma/.gitkeep

