# Environment Configuration for EduNex AI Backend

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="EduNex AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & Tokens
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edunex_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunex_db

# LLM Providers (Required for Agent & RAG execution)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Optional Ollama Local LLM Provider
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ChromaDB & Document Storage
CHROMA_PERSIST_DIR="./data/chroma"
UPLOAD_DIR="./data/uploads"

